<script>
  /* ============================================================
     LITHIUM UI — JavaScript API
     Creator: rightpapi
  ============================================================ */
  const LithiumUI = (() => {

    /* ----------------------------------------------------------
       TOAST SYSTEM
    ---------------------------------------------------------- */
    const TOAST_DURATION = 3200;
    const toastContainer = document.getElementById('li-toast-container');

    const ICONS = {
      default: '◈',
      success: '◉',
      warn:    '◎',
      danger:  '◌',
    };

    function toast(message, type = 'default', duration = TOAST_DURATION) {
      const el = document.createElement('div');
      el.className = `li-toast${type !== 'default' ? ' ' + type : ''}`;
      el.innerHTML = `<span class="li-toast-icon">${ICONS[type] ?? ICONS.default}</span>${message}`;
      toastContainer.appendChild(el);

      const dismiss = () => {
        el.classList.add('li-toast-out');
        el.addEventListener('animationend', () => el.remove(), { once: true });
      };

      const timer = setTimeout(dismiss, duration);
      el.addEventListener('click', () => { clearTimeout(timer); dismiss(); });
    }

    /* ----------------------------------------------------------
       WINDOW DRAG
    ---------------------------------------------------------- */
    function makeDraggable(windowEl, handleEl) {
      let dragging = false;
      let ox = 0, oy = 0;

      handleEl.addEventListener('mousedown', e => {
        if (e.button !== 0) return;
        dragging = true;
        const rect = windowEl.getBoundingClientRect();
        ox = e.clientX - rect.left;
        oy = e.clientY - rect.top;
        windowEl.style.position = 'fixed';
        e.preventDefault();
      });

      document.addEventListener('mousemove', e => {
        if (!dragging) return;
        const parent = windowEl.parentElement?.getBoundingClientRect() ?? { left: 0, top: 0, width: window.innerWidth, height: window.innerHeight };
        let x = e.clientX - ox - parent.left;
        let y = e.clientY - oy - parent.top;
        x = Math.max(0, Math.min(x, parent.width  - windowEl.offsetWidth));
        y = Math.max(0, Math.min(y, parent.height - windowEl.offsetHeight));
        windowEl.style.left = x + 'px';
        windowEl.style.top  = y + 'px';
      });

      document.addEventListener('mouseup', () => { dragging = false; });
    }

    /* ----------------------------------------------------------
       STATIC TAB INIT — wires existing HTML tab markup
    ---------------------------------------------------------- */
    function initTabs(containerEl) {
      const tabs   = containerEl.querySelectorAll(':scope .li-tabs > .li-tab');
      const panels = containerEl.querySelectorAll(':scope .li-tab-panel');

      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          tabs.forEach(t => t.classList.remove('active'));
          panels.forEach(p => p.classList.remove('active'));
          tab.classList.add('active');
          const target = containerEl.querySelector(`#tab-${tab.dataset.tab}`);
          if (target) target.classList.add('active');
        });
      });
    }

    /* ----------------------------------------------------------
       EXTENSION REGISTRY
       LithiumUI.extend(name, fn) — register a named extension.
       fn receives the Window instance and returns an object:
         { label, id, build(panelEl) }
       The window's .use(name) method mounts it as a new tab.
    ---------------------------------------------------------- */
    const _extensions = {};

    function extend(name, fn) {
      if (_extensions[name]) {
        console.warn(`[Lithium] Extension "${name}" is already registered. Skipping.`);
        return;
      }
      _extensions[name] = fn;
    }

    function _getExtension(name) {
      return _extensions[name] ?? null;
    }

    /* ----------------------------------------------------------
       WINDOW CLASS
       Wraps a li-window DOM element and exposes:
         .addTab(id, label, builderFn)  — add a tab at any time
         .removeTab(id)                 — remove a tab by id
         .activateTab(id)               — switch to a tab
         .use(extensionName)            — mount a registered extension
         .mount(parentEl)               — append to DOM
         .destroy()                     — remove from DOM
    ---------------------------------------------------------- */
    class Window {
      constructor(options = {}) {
        const {
          title    = 'Lithium',
          subtitle = '',
          width    = 300,
          top      = 40,
          left     = 40,
        } = options;

        this._tabs   = new Map(); // id → { tabEl, panelEl }
        this._uid    = `liw-${Math.random().toString(36).slice(2, 8)}`;

        /* Root element */
        this.el = document.createElement('div');
        this.el.className = 'li-window';
        this.el.style.cssText = `top:${top}px;left:${left}px;width:${width}px;position:fixed;`;

        /* Titlebar */
        this._titlebar = document.createElement('div');
        this._titlebar.className = 'li-titlebar';
        this._titlebar.innerHTML = `
          <div class="li-title-left">
            <div class="li-logo-mark">Li</div>
            <span class="li-title-text">${title}</span>
            ${subtitle ? `<span class="li-title-tag">${subtitle}</span>` : ''}
          </div>
          <div class="li-window-controls">
            <button class="li-control-btn li-close" title="Close">&#x2715;</button>
          </div>`;

        /* Tab bar (starts hidden; shown once first tab is added) */
        this._tabBar = document.createElement('div');
        this._tabBar.className = 'li-tabs';
        this._tabBar.style.display = 'none';

        /* Body wrapper — holds tab bar + panels */
        this._body = document.createElement('div');
        this._body.className = 'li-body';
        this._body.appendChild(this._tabBar);

        this.el.appendChild(this._titlebar);
        this.el.appendChild(this._body);

        /* Wire close button */
        this._titlebar.querySelector('.li-close')
          .addEventListener('click', () => this.destroy());

        /* Wire drag */
        makeDraggable(this.el, this._titlebar);
      }

      /* Add a tab. builderFn(panelEl) — populate the panel element. */
      addTab(id, label, builderFn) {
        if (this._tabs.has(id)) {
          console.warn(`[Lithium] Tab "${id}" already exists on this window.`);
          return this;
        }

        /* Tab button */
        const tabEl = document.createElement('div');
        tabEl.className = 'li-tab';
        tabEl.dataset.tab = id;
        tabEl.textContent = label;
        tabEl.addEventListener('click', () => this.activateTab(id));
        this._tabBar.appendChild(tabEl);

        /* Panel */
        const panelEl = document.createElement('div');
        panelEl.className = 'li-tab-panel';
        panelEl.id = `tab-${this._uid}-${id}`;
        this._body.appendChild(panelEl);

        this._tabs.set(id, { tabEl, panelEl });

        /* Run builder */
        builderFn(panelEl);

        /* Show tab bar now that we have at least one tab */
        this._tabBar.style.display = '';

        /* Auto-activate if it's the first tab */
        if (this._tabs.size === 1) this.activateTab(id);

        return this;
      }

      /* Remove a tab by id. Activates the previous tab if it was active. */
      removeTab(id) {
        const entry = this._tabs.get(id);
        if (!entry) return this;

        const wasActive = entry.tabEl.classList.contains('active');
        entry.tabEl.remove();
        entry.panelEl.remove();
        this._tabs.delete(id);

        if (this._tabs.size === 0) {
          this._tabBar.style.display = 'none';
        } else if (wasActive) {
          this.activateTab(this._tabs.keys().next().value);
        }

        return this;
      }

      /* Switch the active tab. */
      activateTab(id) {
        this._tabs.forEach(({ tabEl, panelEl }, key) => {
          const active = key === id;
          tabEl.classList.toggle('active', active);
          panelEl.classList.toggle('active', active);
        });
        return this;
      }

      /* Mount a registered extension as a new tab. */
      use(extensionName) {
        const factory = _getExtension(extensionName);
        if (!factory) {
          console.error(`[Lithium] Extension "${extensionName}" is not registered.`);
          return this;
        }
        const ext = factory(this);
        if (!ext?.id || !ext?.label || typeof ext?.build !== 'function') {
          console.error(`[Lithium] Extension "${extensionName}" must return { id, label, build }.`);
          return this;
        }
        this.addTab(ext.id, ext.label, ext.build.bind(ext));
        return this;
      }

      /* Append the window to a parent element (defaults to document.body). */
      mount(parentEl = document.body) {
        parentEl.appendChild(this.el);
        return this;
      }

      /* Remove from DOM. */
      destroy() {
        this.el.remove();
      }
    }

    /* ----------------------------------------------------------
       LEGACY createWindow — kept for backward compatibility.
       Returns { win, body } as before.
    ---------------------------------------------------------- */
    function createWindow(options = {}) {
      const instance = new Window(options);
      return { win: instance.el, body: instance._body, instance };
    }

    /* ----------------------------------------------------------
       PUBLIC API
    ---------------------------------------------------------- */
    return { toast, makeDraggable, initTabs, extend, Window, createWindow };
  })();

  /* ============================================================
     BUILT-IN EXTENSIONS
     Bundled with the library. Scripts call .use('name') to mount.
  ============================================================ */

  /* --- Credits extension ------------------------------------ */
  LithiumUI.extend('credits', () => ({
    id:    'credits',
    label: 'Credits',
    build(panelEl) {
      panelEl.innerHTML = `
        <div class="li-section-label">Script</div>
        <div class="li-status-row" style="justify-content:space-between;">
          <span style="font-size:11px;color:var(--li-text-muted);">Creator</span>
          <span style="font-family:var(--li-font);font-size:11px;color:var(--li-text);">rightpapi</span>
        </div>
        <div class="li-status-row" style="justify-content:space-between;">
          <span style="font-size:11px;color:var(--li-text-muted);">Library</span>
          <span style="font-family:var(--li-font);font-size:11px;color:var(--li-text);">Lithium UI</span>
        </div>
        <div class="li-divider"></div>
        <div class="li-section-label">Version</div>
        <div class="li-status-row" style="justify-content:space-between;">
          <span style="font-size:11px;color:var(--li-text-muted);">Build</span>
          <span style="font-family:var(--li-font);font-size:11px;color:var(--li-text-muted);" id="li-credits-ver">—</span>
        </div>`;
      /* Stamp build date at mount time */
      panelEl.querySelector('#li-credits-ver').textContent =
        new Date().toISOString().slice(0, 10);
    },
  }));

  /* --- Keybinds extension ---------------------------------- */
  LithiumUI.extend('keybinds', (win) => ({
    id:    'keys',
    label: 'Keys',
    _binds: [],
    addBind(name, keys) { this._binds.push({ name, keys }); return this; },
    build(panelEl) {
      if (this._binds.length === 0) {
        panelEl.innerHTML = `<div style="font-size:11px;color:var(--li-text-dim);padding:4px 0;">No keybinds registered.</div>`;
        return;
      }
      this._binds.forEach(({ name, keys }) => {
        const row = document.createElement('div');
        row.className = 'li-keybind-row';
        const keyPills = keys.map(k => `<span class="li-key">${k}</span>`).join('<span class="li-key-sep">+</span>');
        row.innerHTML = `<span class="li-keybind-name">${name}</span><div class="li-keybind-keys">${keyPills}</div>`;
        panelEl.appendChild(row);
      });
    },
  }));

  /* --- Performance extension ------------------------------- */
  LithiumUI.extend('performance', () => ({
    id:    'perf',
    label: 'Perf',
    _statEls: {},
    build(panelEl) {
      panelEl.innerHTML = `
        <div class="li-section-label">Runtime</div>
        <div class="li-stat-grid">
          <div class="li-stat"><div class="li-stat-value" id="li-perf-fps">—</div><div class="li-stat-label">FPS</div></div>
          <div class="li-stat"><div class="li-stat-value" id="li-perf-mem">—</div><div class="li-stat-label">Heap MB</div></div>
          <div class="li-stat"><div class="li-stat-value" id="li-perf-up">0s</div><div class="li-stat-label">Uptime</div></div>
        </div>
        <div class="li-divider"></div>
        <div class="li-section-label">Frame budget</div>
        <div class="li-progress-wrap">
          <div class="li-progress-header">
            <span class="li-progress-name">Frame time</span>
            <span class="li-progress-pct" id="li-perf-ft">—</span>
          </div>
          <div class="li-progress-track"><div class="li-progress-fill" id="li-perf-bar" style="width:0%"></div></div>
        </div>`;

      const fpsEl  = panelEl.querySelector('#li-perf-fps');
      const memEl  = panelEl.querySelector('#li-perf-mem');
      const upEl   = panelEl.querySelector('#li-perf-up');
      const ftEl   = panelEl.querySelector('#li-perf-ft');
      const barEl  = panelEl.querySelector('#li-perf-bar');

      let frames = 0, lastFpsTime = performance.now(), lastFrame = performance.now();
      const startTime = performance.now();

      const tick = (now) => {
        if (!panelEl.isConnected) return; // stop polling when removed

        const delta = now - lastFrame;
        lastFrame   = now;
        frames++;

        if (now - lastFpsTime >= 1000) {
          const fps = Math.round(frames * 1000 / (now - lastFpsTime));
          fpsEl.textContent = fps;
          frames = 0;
          lastFpsTime = now;
        }

        /* Heap — only available in Chromium */
        if (performance.memory) {
          memEl.textContent = (performance.memory.usedJSHeapSize / 1048576).toFixed(1);
        }

        /* Uptime */
        const secs = Math.floor((now - startTime) / 1000);
        upEl.textContent = secs < 60 ? `${secs}s` : `${Math.floor(secs/60)}m${secs%60}s`;

        /* Frame budget — target 16.67ms (60fps) */
        const pct = Math.min(100, Math.round(delta / 16.67 * 100));
        ftEl.textContent = `${delta.toFixed(1)}ms`;
        barEl.style.width = `${pct}%`;
        barEl.style.background = pct > 90 ? 'var(--li-danger)' : pct > 60 ? 'var(--li-warn)' : 'var(--li-text)';

        requestAnimationFrame(tick);
      };

      requestAnimationFrame(tick);
    },
  }));

  /* ============================================================
     WIRE DEMO COMPONENTS
  ============================================================ */
  (() => {
    /* Static HTML demo window (drag + tabs) */
    const demoWin    = document.getElementById('demo-window');
    const demoHandle = document.getElementById('demo-titlebar');
    if (demoWin && demoHandle) LithiumUI.makeDraggable(demoWin, demoHandle);
    document.querySelectorAll('.li-window').forEach(c => LithiumUI.initTabs(c));

    /* ----------------------------------------------------------
       LIVE DEMO — Window class + extensions
       Spawned into the "Extension Demo" card.
    ---------------------------------------------------------- */
    const demoParent = document.getElementById('ext-demo-mount');
    if (demoParent) {
      const win = new LithiumUI.Window({
        title: 'Lithium', subtitle: 'Demo', width: 300, top: 0, left: 0,
      });

      /* Override position for inline card demo */
      win.el.style.position = 'relative';
      win.el.style.top  = '0';
      win.el.style.left = '0';
      win.el.style.width = '100%';

      /* Script tab — built inline via addTab */
      win.addTab('main', 'Main', panel => {
        panel.innerHTML = `
          <div class="li-section-label">Features</div>
          <label class="li-toggle-row">
            <div class="li-toggle-label">Silent Aim<small>Server-side redirect</small></div>
            <div class="li-toggle"><input type="checkbox" checked />
              <div class="li-toggle-track"><div class="li-toggle-thumb"></div></div>
            </div>
          </label>
          <label class="li-toggle-row">
            <div class="li-toggle-label">Prediction<small>Lead moving targets</small></div>
            <div class="li-toggle"><input type="checkbox" />
              <div class="li-toggle-track"><div class="li-toggle-thumb"></div></div>
            </div>
          </label>
          <div class="li-divider"></div>
          <div class="li-slider-row">
            <div class="li-slider-header">
              <span class="li-slider-name">FOV</span>
              <span class="li-slider-value" id="ext-fov-val">80</span>
            </div>
            <input class="li-slider" type="range" min="10" max="200" value="80"
              oninput="document.getElementById('ext-fov-val').textContent=this.value" />
          </div>`;
      });

      /* Mount built-in extensions */
      win.use('performance');
      win.use('credits');

      /* Custom extension defined inline for this demo */
      LithiumUI.extend('demo-log', () => ({
        id: 'log', label: 'Log',
        build(panel) {
          panel.innerHTML = `
            <div class="li-section-label">Event Log</div>
            <div id="li-demo-log" style="
              font-family:var(--li-font);font-size:10px;color:var(--li-text-muted);
              display:flex;flex-direction:column;gap:4px;max-height:140px;overflow-y:auto;">
            </div>
            <button class="li-btn li-btn-outline li-btn-sm li-btn-full" id="li-log-fire">Fire Event</button>`;

          const logEl = panel.querySelector('#li-demo-log');
          const addLog = (msg, type = 'info') => {
            const colors = { info: 'var(--li-text-muted)', ok: 'var(--li-success)', err: 'var(--li-danger)', warn: 'var(--li-warn)' };
            const line = document.createElement('div');
            line.style.color = colors[type] ?? colors.info;
            line.textContent = `[${new Date().toLocaleTimeString()}] ${msg}`;
            logEl.prepend(line);
            if (logEl.children.length > 20) logEl.lastElementChild.remove();
          };
          addLog('Log extension mounted.', 'ok');
          panel.querySelector('#li-log-fire').addEventListener('click', () => {
            const msgs = ['Target acquired', 'Prediction recalculated', 'FOV updated', 'Frame dropped', 'Memory GC triggered'];
            const types = ['info', 'ok', 'warn', 'err'];
            addLog(msgs[Math.floor(Math.random() * msgs.length)], types[Math.floor(Math.random() * types.length)]);
          });
        },
      }));
      win.use('demo-log');

      win.mount(demoParent);
    }

    /* Fire load toast */
    setTimeout(() => LithiumUI.toast('Lithium dose administered.'), 600);
  })();
</script>
</body>
</html>
