-- Targeting + Silent (kept for completeness)
local Sticky = nil
local function GetClosest(silent)
    local fov = silent and CFG.SilentAimFOV or CFG.AimbotFOV
    local partN = silent and CFG.SilentAimPart or CFG.AimbotPart
    local pred = silent and CFG.SilentAimPrediction or CFG.AimbotPrediction
    local spd = silent and CFG.SilentAimBulletSpeed or CFG.AimbotBulletSpeed
    local mult = silent and CFG.SilentAimPredictMult or CFG.AimbotPredictMult
    local vis = silent and CFG.SilentAimVisCheck or CFG.AimbotVisCheck

    if silent and CFG.SilentAimSticky and Sticky and Alive(Sticky) and IsEnemy(Sticky) then
        local part = GetPart(Sticky, partN)
        if part then
            local pos = pred and Predict(part, spd, mult) or part.Position
            local sp, on = W2V(pos)
            if on and FOVDist(sp) <= fov and (not vis or Visible(Camera.CFrame.Position, pos)) then
                return Sticky, pos
            end
        end
        Sticky = nil
    end

    local best, bestD, bestPos = nil, math.huge, nil
    for _,p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer or not IsEnemy(p) or not Alive(p) then continue end
        local part = GetPart(p, partN) if not part then continue end
        local pos = pred and Predict(part, spd, mult) or part.Position
        local sp, on = W2V(pos) if not on then continue end
        local d = FOVDist(sp) if d > fov then continue end
        if vis and not Visible(Camera.CFrame.Position, pos) then continue end
        if d < bestD then bestD = d best = p bestPos = pos end
    end
    if silent and CFG.SilentAimSticky then Sticky = best end
    return best, bestPos
end

local SilentOn = false
local oldIndex, oldNamecall
local function EnableSilent()
    if SilentOn then return end
    local ok, mt = pcall(getrawmetatable, game)
    if ok and mt then
        oldIndex = mt.__index
        pcall(setreadonly, mt, false)
        mt.__index = newcclosure(function(self, key)
            if CFG.SilentAimEnabled and (CFG.SilentAimMethod == "Mouse" or CFG.SilentAimMethod == "Both") then
                if self == Mouse and key == "Hit" then
                    if math.random(1,100) > CFG.SilentAimHitChance then return oldIndex(self, key) end
                    local _, pos = GetClosest(true)
                    if pos then return CFrame.new(pos) end
                end
            end
            return oldIndex(self, key)
        end)
        pcall(setreadonly, mt, true)
    end
    pcall(function()
        local camMt = getrawmetatable(Camera)
        if camMt then
            oldNamecall = camMt.__namecall
            pcall(setreadonly, camMt, false)
            camMt.__namecall = newcclosure(function(self, ...)
                local method = getnamecallmethod()
                if CFG.SilentAimEnabled and (CFG.SilentAimMethod == "Ray" or CFG.SilentAimMethod == "Both") then
                    if method == "ScreenPointToRay" or method == "ViewportPointToRay" then
                        if math.random(1,100) <= CFG.SilentAimHitChance then
                            local _, pos = GetClosest(true)
                            if pos then
                                local origin = Camera.CFrame.Position
                                return Ray.new(origin, (pos - origin).Unit * 1000)
                            end
                        end
                    end
                end
                return oldNamecall(self, ...)
            end)
            pcall(setreadonly, camMt, true)
        end
    end)
    SilentOn = true
    Notify("Silent Aim ON")
end
local function DisableSilent()
    if not SilentOn then return end
    pcall(function()
        local mt = getrawmetatable(game)
        if mt and oldIndex then setreadonly(mt, false) mt.__index = oldIndex setreadonly(mt, true) end
    end)
    pcall(function()
        local camMt = getrawmetatable(Camera)
        if camMt and oldNamecall then setreadonly(camMt, false) camMt.__namecall = oldNamecall setreadonly(camMt, true) end
    end)
    SilentOn = false
    Sticky = nil
    Notify("Silent Aim OFF")
end

-- Speed / God / Dig / Ammo / Noclip (unchanged safe versions)
local SpeedConn
local function StartSpeed()
    if SpeedConn then return end
    SpeedConn = RunService.Heartbeat:Connect(function()
        if not CFG.SpeedEnabled then return end
        local char = LocalPlayer.Character if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not root or not hum or hum.Health <= 0 then return end
        local dir = hum.MoveDirection if dir.Magnitude < 0.05 then return end
        local extra = dir.Unit * (16 * (CFG.SpeedMult - 1))
        root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X + extra.X, root.AssemblyLinearVelocity.Y, root.AssemblyLinearVelocity.Z + extra.Z)
    end)
end
local function StopSpeed() if SpeedConn then SpeedConn:Disconnect() SpeedConn = nil end end

local GodConn
local function EnableGod()
    local hum = GetHum(LocalPlayer) if not hum then return end
    if GodConn then GodConn:Disconnect() end
    GodConn = hum.HealthChanged:Connect(function()
        if CFG.GodModeEnabled and hum.Health < hum.MaxHealth then hum.Health = hum.MaxHealth end
    end)
end
local function DisableGod() if GodConn then GodConn:Disconnect() GodConn = nil end end

local function PatchDig()
    local char = LocalPlayer.Character if not char then return end
    local function zero(parent)
        for _,v in ipairs(parent:GetDescendants()) do
            if v:IsA("NumberValue") or v:IsA("IntValue") then
                local n = v.Name:lower()
                if n:find("cool") or n:find("cd") or n:find("delay") or n:find("timer") or n:find("dig") then
                    pcall(function() v.Value = 0 end)
                    v.Changed:Connect(function() if CFG.NoDigCooldown and v.Value > 0 then pcall(function() v.Value = 0 end) end end)
                end
            end
        end
    end
    zero(char)
    for _,t in ipairs(LocalPlayer.Backpack:GetChildren()) do if t:IsA("Tool") then zero(t) end end
end

local function HookAmmo()
    local char = LocalPlayer.Character if not char then return end
    local function patch(tool)
        for _,v in ipairs(tool:GetDescendants()) do
            if v:IsA("IntValue") or v:IsA("NumberValue") then
                local n = v.Name:lower()
                if n:find("ammo") or n:find("bullet") or n:find("round") or n:find("mag") or n:find("clip") then
                    if CFG.InfAmmoEnabled then pcall(function() v.Value = 999 end) end
                    v.Changed:Connect(function() if CFG.InfAmmoEnabled and v.Value < 999 then pcall(function() v.Value = 999 end) end end)
                end
            end
        end
    end
    local tool = char:FindFirstChildOfClass("Tool") if tool then patch(tool) end
    for _,t in ipairs(LocalPlayer.Backpack:GetChildren()) do if t:IsA("Tool") then patch(t) end end
end

local NoclipConn
local function EnableNoclip()
    if NoclipConn then return end
    NoclipConn = RunService.Stepped:Connect(function()
        if not CFG.NoclipEnabled then return end
        local char = LocalPlayer.Character if not char then return end
        for _,p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end
    end)
end
local function DisableNoclip() if NoclipConn then NoclipConn:Disconnect() NoclipConn = nil end end

local function SetFullbright(on)
    if on then
        Lighting.Brightness = 2 Lighting.ClockTime = 14 Lighting.FogEnd = 1e5
        Lighting.GlobalShadows = false Lighting.Ambient = Color3.new(1,1,1) Lighting.OutdoorAmbient = Color3.new(1,1,1)
    else
        Lighting.Brightness = 1 Lighting.GlobalShadows = true
        Lighting.Ambient = Color3.new(0.5,0.5,0.5) Lighting.OutdoorAmbient = Color3.new(0.5,0.5,0.5)
    end
end

local function OnChar(char)
    task.wait(1.0)
    if CFG.GodModeEnabled then EnableGod() end
    if CFG.InfAmmoEnabled then HookAmmo() end
    if CFG.NoDigCooldown then PatchDig() end
    if CFG.SpeedEnabled then StartSpeed() end
    if CFG.SilentAimEnabled then DisableSilent() task.wait(0.1) EnableSilent() end
end
LocalPlayer.CharacterAdded:Connect(OnChar)
if LocalPlayer.Character then task.spawn(OnChar, LocalPlayer.Character) end

local AimHeld, TriggerHeld = false, false
RunService.RenderStepped:Connect(function()
    pcall(UpdateESP)

    if FOVCircle then
        local show = CFG.FOVCircleEnabled and (CFG.AimbotEnabled or CFG.SilentAimEnabled)
        FOVCircle.Visible = show
        if show then
            FOVCircle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
            FOVCircle.Radius = CFG.AimbotEnabled and CFG.AimbotFOV or CFG.SilentAimFOV
            FOVCircle.Color = CFG.FOVCircleColor
            FOVCircle.Thickness = CFG.FOVCircleThickness
            FOVCircle.Transparency = CFG.FOVCircleTrans
            FOVCircle.Filled = CFG.FOVCircleFill
        end
    end

    if Watermark then
        Watermark.Visible = CFG.ShowWatermark
        if CFG.ShowWatermark then
            Watermark.Text = "FIELD OPS  v2.7  |  " .. math.floor(Workspace:GetRealPhysicsFPS()) .. " fps"
            Watermark.Position = Vector2.new(12, 8)
            Watermark.Color = T().accent
        end
    end

    if KeybindText then
        KeybindText.Visible = CFG.ShowKeybinds
        if CFG.ShowKeybinds then
            local lines = {}
            if CFG.AimbotEnabled then table.insert(lines, "[E] Aimbot") end
            if CFG.SilentAimEnabled then table.insert(lines, "[SA] Silent") end
            if CFG.SpeedEnabled then table.insert(lines, "[SPD] Speed") end
            if CFG.TriggerBot then table.insert(lines, "[Q] Trigger") end
            KeybindText.Text = table.concat(lines, "\n")
            KeybindText.Position = Vector2.new(12, 28)
            KeybindText.Color = T().text
        end
    end

    if CFG.AimbotEnabled and AimHeld then
        local _, pos = GetClosest(false)
        if pos then Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, pos), CFG.AimbotSmoothing) end
    end

    if CFG.TriggerBot and TriggerHeld then
        if GetClosest(false) then pcall(function() mouse1click() end) end
    end

    if CFG.GodModeEnabled then
        local hum = GetHum(LocalPlayer)
        if hum and hum.Health < hum.MaxHealth then hum.Health = hum.MaxHealth end
    end
    if CFG.NoDigCooldown then pcall(PatchDig) end
end)

