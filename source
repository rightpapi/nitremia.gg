local function Toggle(parent, text, y, key, cb)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1,0,0,28)
    row.Position = UDim2.new(0,0,0,y)
    row.BackgroundColor3 = COL.light
    row.BorderColor3 = COL.edge
    row.BorderSizePixel = 1
    row.Parent = parent

    local led = Instance.new("Frame")
    led.Size = UDim2.new(0,10,0,10)
    led.AnchorPoint = Vector2.new(0,0.5)
    led.Position = UDim2.new(0,10,0.5,0)
    led.BackgroundColor3 = Color3.fromRGB(180,40,30)
    led.BorderSizePixel = 1
    led.Parent = row
    Instance.new("UICorner", led).CornerRadius = UDim.new(1,0)

    local lab = Instance.new("TextLabel")
    lab.Size = UDim2.new(1,-80,1,0)
    lab.Position = UDim2.new(0,28,0,0)
    lab.BackgroundTransparency = 1
    lab.Text = text
    lab.TextColor3 = COL.text
    lab.Font = Enum.Font.Gotham
    lab.TextSize = 12
    lab.TextXAlignment = Enum.TextXAlignment.Left
    lab.Parent = row

    local stamp = Instance.new("TextLabel")
    stamp.Size = UDim2.new(0,36,0,18)
    stamp.AnchorPoint = Vector2.new(1,0.5)
    stamp.Position = UDim2.new(1,-6,0.5,0)
    stamp.BackgroundColor3 = COL.mid
    stamp.BorderColor3 = COL.edge
    stamp.BorderSizePixel = 1
    stamp.Text = "OFF"
    stamp.TextColor3 = Color3.fromRGB(180,40,30)
    stamp.Font = Enum.Font.GothamBold
    stamp.TextSize = 10
    stamp.Parent = row

    local on = CFG[key] or false
    local function refresh()
        if on then
            led.BackgroundColor3 = COL.accent
            stamp.Text = "ON" stamp.TextColor3 = COL.accent
        else
            led.BackgroundColor3 = Color3.fromRGB(180,40,30)
            stamp.Text = "OFF" stamp.TextColor3 = Color3.fromRGB(180,40,30)
        end
    end
    refresh()

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1,0,1,0)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.Parent = row
    btn.MouseButton1Click:Connect(function()
        on = not on CFG[key] = on refresh()
        if cb then cb(on) end
        if CFG.ShowNotifs then Notify(text .. (on and " ON" or " OFF")) end
    end)
end

local function Slider(parent, text, y, key, minv, maxv, def, cb)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1,0,0,44)
    row.Position = UDim2.new(0,0,0,y)
    row.BackgroundColor3 = COL.light
    row.BorderColor3 = COL.edge
    row.BorderSizePixel = 1
    row.Parent = parent

    local lab = Instance.new("TextLabel")
    lab.Size = UDim2.new(1,-60,0,18)
    lab.Position = UDim2.new(0,10,0,2)
    lab.BackgroundTransparency = 1
    lab.Text = text
    lab.TextColor3 = COL.text
    lab.Font = Enum.Font.Gotham
    lab.TextSize = 12
    lab.TextXAlignment = Enum.TextXAlignment.Left
    lab.Parent = row

    local val = Instance.new("TextLabel")
    val.Size = UDim2.new(0,50,0,18)
    val.AnchorPoint = Vector2.new(1,0)
    val.Position = UDim2.new(1,-4,0,2)
    val.BackgroundColor3 = COL.mid
    val.BorderColor3 = COL.edge
    val.BorderSizePixel = 1
    val.Text = tostring(def)
    val.TextColor3 = COL.accent
    val.Font = Enum.Font.Code
    val.TextSize = 11
    val.Parent = row

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1,-20,0,8)
    track.Position = UDim2.new(0,10,0,28)
    track.BackgroundColor3 = Color3.fromRGB(20,20,18)
    track.BorderColor3 = COL.edge
    track.BorderSizePixel = 1
    track.Parent = row

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0,0,1,0)
    fill.BackgroundColor3 = COL.accent
    fill.BorderSizePixel = 0
    fill.Parent = track

    local function set(v)
        v = math.clamp(math.floor(v + 0.5), minv, maxv)
        CFG[key] = v
        local r = (v - minv) / math.max(maxv - minv, 1)
        fill.Size = UDim2.new(r, 0, 1, 0)
        val.Text = tostring(v)
        if cb then cb(v) end
    end
    set(def)

    local sliding = false
    local hit = Instance.new("TextButton")
    hit.Size = UDim2.new(1,0,1,0)
    hit.BackgroundTransparency = 1
    hit.Text = ""
    hit.Parent = track
    hit.MouseButton1Down:Connect(function() sliding = true end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then sliding = false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if sliding and i.UserInputType == Enum.UserInputType.MouseMovement then
            local r = math.clamp((i.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            set(minv + r * (maxv - minv))
        end
    end)
end

local function Dropdown(parent, text, y, key, opts, def, cb)
    local BASE, ITEM = 32, 24
    local wrap = Instance.new("Frame")
    wrap.Size = UDim2.new(1,0,0,BASE)
    wrap.Position = UDim2.new(0,0,0,y)
    wrap.BackgroundTransparency = 1
    wrap.ZIndex = 50
    wrap.Parent = parent

    local row = Instance.new("Frame")
    row.Size = UDim2.new(1,0,0,BASE)
    row.BackgroundColor3 = COL.light
    row.BorderColor3 = COL.edge
    row.BorderSizePixel = 1
    row.ZIndex = 50
    row.Parent = wrap

    local lab = Instance.new("TextLabel")
    lab.Size = UDim2.new(0.45,0,1,0)
    lab.Position = UDim2.new(0,10,0,0)
    lab.BackgroundTransparency = 1
    lab.Text = text
    lab.TextColor3 = COL.text
    lab.Font = Enum.Font.Gotham
    lab.TextSize = 12
    lab.TextXAlignment = Enum.TextXAlignment.Left
    lab.ZIndex = 51
    lab.Parent = row

    local sel = Instance.new("TextLabel")
    sel.Size = UDim2.new(0.5,-20,1,0)
    sel.Position = UDim2.new(0.45,0,0,0)
    sel.BackgroundTransparency = 1
    sel.Text = def
    sel.TextColor3 = COL.accent
    sel.Font = Enum.Font.GothamBold
    sel.TextSize = 11
    sel.TextXAlignment = Enum.TextXAlignment.Right
    sel.ZIndex = 51
    sel.Parent = row

    local list = Instance.new("Frame")
    list.Size = UDim2.new(1,0,0,#opts * ITEM)
    list.Position = UDim2.new(0,0,0,BASE)
    list.BackgroundColor3 = COL.mid
    list.BorderColor3 = COL.accent
    list.BorderSizePixel = 1
    list.Visible = false
    list.ZIndex = 100
    list.Parent = wrap

    for i, opt in ipairs(opts) do
        local it = Instance.new("TextButton")
        it.Size = UDim2.new(1,0,0,ITEM)
        it.Position = UDim2.new(0,0,0,(i-1)*ITEM)
        it.BackgroundColor3 = COL.mid
        it.BorderSizePixel = 0
        it.Text = opt
        it.TextColor3 = (opt == def) and COL.accent or COL.dim
        it.Font = Enum.Font.Gotham
        it.TextSize = 11
        it.ZIndex = 101
        it.Parent = list
        it.MouseButton1Click:Connect(function()
            sel.Text = opt CFG[key] = opt
            list.Visible = false
            wrap.Size = UDim2.new(1,0,0,BASE)
            if cb then cb(opt) end
        end)
    end

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1,0,1,0)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.ZIndex = 52
    btn.Parent = row
    btn.MouseButton1Click:Connect(function()
        list.Visible = not list.Visible
        wrap.Size = list.Visible and UDim2.new(1,0,0,BASE + #opts * ITEM) or UDim2.new(1,0,0,BASE)
    end)
end

