local function Switch(i)
    for k, p in ipairs(Panels) do p.Visible = (k == i) end
    for k, b in ipairs(Buttons) do
        if k == i then
            b.TextColor3 = COL.accent
            b.BackgroundColor3 = COL.mid
        else
            b.TextColor3 = Color3.new(1,1,1)
            b.BackgroundColor3 = COL.edge
        end
    end
end
for i, b in ipairs(Buttons) do b.MouseButton1Click:Connect(function() Switch(i) end) end

