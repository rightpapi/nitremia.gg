local ESPCache = {}
local function ESPColor(p)
    if CFG.ESPTeamColor then
        return (p.Team == LocalPlayer.Team) and Color3.fromRGB(0,190,255) or Color3.fromRGB(255,55,55)
    end
    return Color3.fromRGB(255,255,255)
end
local function MakeESP(p)
    if ESPCache[p] then return end
    ESPCache[p] = {
        Box = NewDraw("Square", {Visible=false, Thickness=CFG.ESPBoxThickness, Filled=false}),
        Name = NewDraw("Text", {Visible=false, Size=CFG.ESPNameSize, Center=true, Outline=true, OutlineColor=Color3.new(0,0,0)}),
        Health = NewDraw("Square", {Visible=false, Thickness=1, Filled=true}),
        HealthBG = NewDraw("Square", {Visible=false, Thickness=1, Filled=true, Color=Color3.fromRGB(30,30,30)}),
        Dist = NewDraw("Text", {Visible=false, Size=11, Center=true, Outline=true, OutlineColor=Color3.new(0,0,0)}),
        Tracer = NewDraw("Line", {Visible=false, Thickness=1}),
    }
end
local function HideESP(p)
    local e = ESPCache[p] if not e then return end
    for _,o in pairs(e) do pcall(function() o.Visible = false end) end
end
local function KillESP(p)
    local e = ESPCache[p] if not e then return end
    for _,o in pairs(e) do pcall(function() o:Remove() end) end
    ESPCache[p] = nil
end

local function UpdateESP()
    for _,p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        if not CFG.ESPShowTeam and not IsEnemy(p) then HideESP(p) continue end
        MakeESP(p)
        local e = ESPCache[p] if not e then continue end
        if not CFG.ESPEnabled or not Alive(p) then HideESP(p) continue end
        local root, hum, char = GetRoot(p), GetHum(p), GetChar(p)
        if not root or not hum or not char then HideESP(p) continue end
        local dist = (Camera.CFrame.Position - root.Position).Magnitude
        if dist > CFG.ESPMaxDist then HideESP(p) continue end

        local head = char:FindFirstChild("Head")
        local top = head and head.Position + Vector3.new(0, head.Size.Y/2 + 0.12, 0) or root.Position + Vector3.new(0, 3.1, 0)
        local bot = root.Position - Vector3.new(0, 3, 0)
        local topS, topOn = W2V(top)
        local botS, botOn = W2V(bot)
        if not topOn and not botOn then HideESP(p) continue end

        local h = math.abs(topS.Y - botS.Y)
        local w = h * 0.55
        local x, y = topS.X - w/2, topS.Y
        local col = ESPColor(p)

        if CFG.ESPBoxes and e.Box then
            e.Box.Visible = true
            e.Box.Color = col
            e.Box.Thickness = CFG.ESPBoxThickness
            e.Box.Size = Vector2.new(w, h)
            e.Box.Position = Vector2.new(x, y)
            e.Box.Transparency = 0
        elseif e.Box then e.Box.Visible = false end

        if CFG.ESPNames and e.Name then
            e.Name.Visible = true
            e.Name.Color = col
            e.Name.Size = CFG.ESPNameSize
            e.Name.Text = p.Name
            e.Name.Position = Vector2.new(topS.X, y - 16)
            e.Name.Transparency = 0
        elseif e.Name then e.Name.Visible = false end

        if CFG.ESPDistance and e.Dist then
            e.Dist.Visible = true
            e.Dist.Text = string.format("[%dm]", math.floor(dist/4))
            e.Dist.Position = Vector2.new(topS.X, botS.Y + 2)
            e.Dist.Transparency = 0
        elseif e.Dist then e.Dist.Visible = false end

        if CFG.ESPHealth and e.Health and e.HealthBG then
            local ratio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
            e.HealthBG.Visible = true
            e.HealthBG.Size = Vector2.new(3, h)
            e.HealthBG.Position = Vector2.new(x - 6, y)
            e.Health.Visible = true
            e.Health.Size = Vector2.new(3, h * ratio)
            e.Health.Position = Vector2.new(x - 6, y + h * (1 - ratio))
            e.Health.Color = Color3.fromRGB(math.floor(255*(1-ratio)), math.floor(255*ratio), 0)
        else
            if e.Health then e.Health.Visible = false end
            if e.HealthBG then e.HealthBG.Visible = false end
        end

        if CFG.ESPTracers and e.Tracer then
            e.Tracer.Visible = true
            e.Tracer.Color = col
            e.Tracer.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
            e.Tracer.To = botS
            e.Tracer.Transparency = 0
        elseif e.Tracer then e.Tracer.Visible = false end
    end
end

