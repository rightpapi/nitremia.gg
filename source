local Drawings = {}
local function NewDraw(class, props)
    local ok,o = pcall(Drawing.new, class)
    if not ok or not o then return nil end
    for k,v in pairs(props or {}) do pcall(function() o[k]=v end) end
    table.insert(Drawings, o)
    return o
end

